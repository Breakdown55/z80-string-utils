        .org 0x8000

start:
        ld ix, 0               ; Error counter


        ; Test 1: Identical strings
        ld hl, test_string1
        ld de, test_string2
        call _streq

        jr nz, .test1_failed
        cp 0
        jr z, .test1_passed

.test1_failed:
        inc ix

.test1_passed:

        ; Test 2: Different strings
        ld hl, test_string1
        ld de, test_string3
        call _streq

        jr z, .test2_failed
        cp 1
        jr z, .test2_passed

.test2_failed:
        inc ix

.test2_passed:

        ; Test 3: Empty strings
        ld hl, test_string4
        ld de, test_string5
        call _streq

        jr nz, .test3_failed
        cp 0
        jr z, .test3_passed

.test3_failed:
        inc ix

.test3_passed:

        ; Test 4: Different lengths
        ld hl, test_string1
        ld de, test_string6
        call _streq

        jr z, .test4_failed
        cp 1
        jr z, .test4_passed

.test4_failed:
        inc ix

.test4_passed:

        ; Test 5: Case sensitivity
        ld hl, test_string1
        ld de, test_string7
        call _streq

        jr z, .test5_failed
        cp 1
        jr z, .test5_passed

.test5_failed:
        inc ix

.test5_passed:
        push ix
        pop bc
        ld a, c
        halt





        .org 0x9000

test_string1: .asciz "Hello"
test_string2: .asciz "Hello"
test_string3: .asciz "World"
test_string4: .asciz ""
test_string5: .asciz ""
test_string6: .asciz "Hell"
test_string7: .asciz "hello"

#include "functions.z80"